# Copy to .env.local (never commit real values). Only names + placeholders here.

# Firebase web config (Google / phone sign-in). These are public identifiers, not secrets, but
# restrict the API key by HTTP referrer (your store domains) and enable only the APIs you need
# in the Google Cloud console, and add your domains to Firebase Auth "Authorized domains".
VITE_API_KEY=your-firebase-web-api-key
VITE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_PROJECT_ID=your-firebase-project-id
VITE_STORAGE_BUCKET=your-project.appspot.com
VITE_MESSAGING_SENDER_ID=000000000000
VITE_APP_ID=1:000000000000:web:0000000000000000
VITE_MEASUREMENT_ID=G-XXXXXXXXXX

# Razorpay: the PUBLIC key id is returned by the API at checkout (key_id) - no Razorpay variable is
# needed here. Never put the Razorpay key SECRET in any VITE_* variable.

# API base URL (defaults to the production API in src/utils/Axios.jsx)
VITE_API_BASE_URL=https://api.example.com/v1/api

# Optional store identity fallbacks, used only when the tenant's public settings do not provide them
VITE_STORE_NAME=
VITE_STORE_LEGAL_NAME=
VITE_STORE_SUPPORT_EMAIL=
VITE_STORE_SUPPORT_PHONE=
VITE_STORE_ADDRESS=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_YOUTUBE=
VITE_SOCIAL_WHATSAPP=

# DEV ONLY: force a tenant header when running on localhost (ignored in production builds).
# The backend resolves the tenant from the request Origin in production.
VITE_TENANT_ID=
